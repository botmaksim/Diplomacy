<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane id="rootPane" fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.diplomacy.desktop.controllers.GameViewController">
   <center>
      <StackPane fx:id="mapContainer" minHeight="0.0" minWidth="0.0" BorderPane.alignment="CENTER" />
   </center>
   <right>
      <VBox prefHeight="200.0" prefWidth="330.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label fx:id="phaseLabel" prefHeight="43.0" prefWidth="310.0" text="Spring 1900. Order Phase">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </Label>
            <Separator prefHeight="10.0" prefWidth="200.0" />

            <HBox spacing="5.0" alignment="CENTER_LEFT">
               <Label text="Player:" />
               <Label fx:id="currentPlayerLabel" text="-" prefWidth="130.0" />
               <Button fx:id="loginButton" mnemonicParsing="false" onAction="#onLoginClick" text="Login" />
               <Button fx:id="spectatorButton" mnemonicParsing="false" onAction="#onSpectatorClick" text="Spectator" />
            </HBox>
            <Separator prefHeight="10.0" prefWidth="200.0" />

            <Label text="Select order:" />
            <fx:define>
               <ToggleGroup fx:id="orderTypeGroup"/>
            </fx:define>
            <VBox spacing="3.0">
               <HBox spacing="5.0">
                  <RadioButton text="None" toggleGroup="$orderTypeGroup" selected="true" prefWidth="65" />
                  <RadioButton text="Hold" toggleGroup="$orderTypeGroup" prefWidth="65" />
                  <RadioButton text="Move" toggleGroup="$orderTypeGroup" prefWidth="65" />
                  <RadioButton text="Support" toggleGroup="$orderTypeGroup" prefWidth="65" />
               </HBox>
               <HBox spacing="5.0">
                  <RadioButton text="Convoy" toggleGroup="$orderTypeGroup" prefWidth="65" />
                  <RadioButton text="BeConvoyed" toggleGroup="$orderTypeGroup" prefWidth="75" />
                  <RadioButton text="Retreat" toggleGroup="$orderTypeGroup" prefWidth="65" />
                  <RadioButton text="Die" toggleGroup="$orderTypeGroup" prefWidth="65" />
               </HBox>
               <HBox spacing="5.0">
                  <RadioButton text="Spawn" toggleGroup="$orderTypeGroup" prefWidth="65" />
                  <RadioButton text="Dismiss" toggleGroup="$orderTypeGroup" prefWidth="65" />
               </HBox>
            </VBox>

            <Separator prefHeight="10.0" prefWidth="200.0" />
            <Label text="Orders (double-click to remove):" />
            <ListView fx:id="ordersListView" prefHeight="180.0" prefWidth="310.0" />
            <Label text="Log:" />
            <TextArea fx:id="logTextArea" editable="false" prefHeight="120.0" prefWidth="310.0" wrapText="true" />

            <Button fx:id="confirmOrdersButton" mnemonicParsing="false" prefHeight="33.0" prefWidth="310.0"
                    text="Confirm Orders" onAction="#onConfirmOrdersClick" />
         </children>
      </VBox>
   </right>
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
         </padding>
         <children>
            <Label text="Diplomacy" />
            <Label fx:id="playerInfoLabel" text="" />
         </children>
      </HBox>
   </top>
</BorderPane>
